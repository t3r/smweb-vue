# Database connection URI (PostgreSQL with PostGIS)
PGURI=postgres://user:password@host:port/dbname

# Path to fgelev binary (for ground elevation lookups)
FGELEV_PATH=/usr/local/bin/fgelev

# FG_ROOT - FlightGear data root (needed by fgelev)
FG_ROOT=/path/to/fg/data

# Local scenery path (mounted or synced terrain data)
FG_SCENERY=/path/to/scenery/remote

# Export output path
FG_SCENERY_EXPORT=/path/to/scenery/export

# Groundnets repo path
GROUNDNETS_PATH=/path/to/groundnets

# Minimum number of pending updates to trigger export (default: 1)
MIN_UPDATES=1

# Sync targets (comma-separated rsync URIs)
SYNC_TARGETS=usmirror:/var/www/terrasync/terrasync/ws2/,dream.t3r.de:ts/ws20/,sf:htdocs/scenery/

# SSH command to invalidate CDN after sync (optional)
CDN_INVALIDATE_CMD=ssh usmirror /var/www/terrasync/invalidate_cdn.sh
